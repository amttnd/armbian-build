From 713095b944542bf1caac1317b315ef25818df095 Mon Sep 17 00:00:00 2001
From: Tam Nguyen <amttnd@gmail.com>
Date: Sun, 30 Aug 2026 20:33:25 +0700
Subject: arm: rk3588: add support for LubanCat 5 V2

Signed-off-by: Tam Nguyen <amttnd@gmail.com>
---
 arch/arm/dts/rk3588-lubancat-5-v2-u-boot.dtsi |  13 +
 configs/lubancat-5-v2-rk3588_defconfig        |  89 +++
 .../arm64/rockchip/rk3588-lubancat-5-v2.dts   | 563 ++++++++++++++++++
 3 files changed, 665 insertions(+)
 create mode 100644 arch/arm/dts/rk3588-lubancat-5-v2-u-boot.dtsi
 create mode 100644 configs/lubancat-5-v2-rk3588_defconfig
 create mode 100644 dts/upstream/src/arm64/rockchip/rk3588-lubancat-5-v2.dts

diff --git a/arch/arm/dts/rk3588-lubancat-5-v2-u-boot.dtsi b/arch/arm/dts/rk3588-lubancat-5-v2-u-boot.dtsi
new file mode 100644
index 00000000000..0967dca5850
--- /dev/null
+++ b/arch/arm/dts/rk3588-lubancat-5-v2-u-boot.dtsi
@@ -0,0 +1,13 @@
+// SPDX-License-Identifier: GPL-2.0+
+
+#include "rk3588-u-boot.dtsi"
+
+&saradc {
+	bootph-pre-ram;
+	vdd-microvolts = <1800000>;
+};
+
+&sdhci {
+	cap-mmc-highspeed;
+	mmc-hs200-1_8v;
+};
diff --git a/configs/lubancat-5-v2-rk3588_defconfig b/configs/lubancat-5-v2-rk3588_defconfig
new file mode 100644
index 00000000000..facd942a89e
--- /dev/null
+++ b/configs/lubancat-5-v2-rk3588_defconfig
@@ -0,0 +1,89 @@
+CONFIG_ARM=y
+CONFIG_SKIP_LOWLEVEL_INIT=y
+CONFIG_COUNTER_FREQUENCY=24000000
+CONFIG_ARCH_ROCKCHIP=y
+CONFIG_DEFAULT_DEVICE_TREE="rockchip/rk3588-lubancat-5-v2"
+CONFIG_ROCKCHIP_RK3588=y
+CONFIG_SPL_SERIAL=y
+CONFIG_TARGET_EVB_RK3588=y
+CONFIG_SYS_LOAD_ADDR=0xc00800
+CONFIG_DEBUG_UART_BASE=0xFEB50000
+CONFIG_DEBUG_UART_CLOCK=24000000
+CONFIG_PCI=y
+CONFIG_DEBUG_UART=y
+CONFIG_FIT=y
+CONFIG_FIT_VERBOSE=y
+CONFIG_SPL_FIT_SIGNATURE=y
+CONFIG_SPL_LOAD_FIT=y
